{
  "$description": "Olvable design tokens, agreed 2026-08-23. Source of truth is app/globals.css; keep this in step.",
  "type": {
    "family": { "primary": "Inter", "mono": "JetBrains Mono" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "scale": [12.5, 13.5, 15, 16.5, 22, 32, 36],
    "tracking": { "display": "-0.02em", "title": "-0.01em", "body": "0", "label": "0.06em" }
  },
  "radius": { "control": 12, "card": 16, "panel": 20, "pill": 999 },
  "shadow": {
    "card": "0 1px 2px rgba(18,19,26,0.04)",
    "float": "0 8px 24px rgba(18,19,26,0.10), 0 2px 6px rgba(18,19,26,0.06)"
  },
  "space": {
    "$note": "Multiples of 4. Page gutter 16 on phones, 24 from sm.",
    "gutter": { "phone": 16, "desktop": 24 }
  },
  "touch": { "minTarget": 44 },
  "mark": {
    "$note": "A ring with a point on it: the cycle and the moment. viewBox 0 0 32 32.",
    "ring": { "cx": 15, "cy": 16, "r": 9.5, "strokeWidth": 3.6 },
    "dot": { "cx": 24.5, "cy": 23.5, "r": 4.2 }
  }
}
