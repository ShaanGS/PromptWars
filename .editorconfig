# Matches what Prettier enforces, so editors agree before the formatter runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false
